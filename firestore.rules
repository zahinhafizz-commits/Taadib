rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email == userId
      );
    }

    function isStaffRole(roleName) {
      return roleName in ['admin', 'warden', 'ketua_warden', 'rollcall_admin', 'supervisor', 'hep'];
    }

    function hasStaffRole(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        isStaffRole(get(/databases/$(database)/documents/users/$(userId)).data.role);
    }

    function isAdminOrWarden() {
      return isSignedIn() && (
        hasStaffRole(request.auth.uid) ||
        (
          request.auth.token.email != null &&
          hasStaffRole(request.auth.token.email)
        )
      );
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrWarden();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isUserOwner(userId) || isAdminOrWarden();
      allow update: if isAdminOrWarden() || (
        isUserOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['password', 'passwordChanged', 'staffPasswordSetup', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /password_reset_requests/{requestId} {
      allow create: if true;
      allow read: if isAdminOrWarden();
      allow update: if isAdminOrWarden();
      allow delete: if false;
    }

    match /laporan/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isAdminOrWarden();
    }
  }
}
